---
import type { Crumb } from '@/lib/seo';
interface Props { items: Crumb[]; tone?: 'default' | 'inverse'; }
const { items, tone = 'default' } = Astro.props;
---
<nav class:list={['crumbs', `crumbs--${tone}`]} aria-label="Breadcrumb">
  <ol role="list">
    {items.map((c, i) => (
      <li>
        {i < items.length - 1
          ? <a href={c.path}>{c.name}</a>
          : <span aria-current="page">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 4px 0; font-size: var(--fs-body-sm); color: var(--text-muted); }
  .crumbs li { display: inline-flex; align-items: center; }
  .crumbs li + li::before { content: '/'; margin: 0 10px; color: var(--border); }
  .crumbs a { text-decoration: none; color: var(--text-secondary); }
  .crumbs a:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { color: var(--text-primary); }
  .crumbs--inverse ol, .crumbs--inverse a { color: var(--text-inverse-muted); }
  .crumbs--inverse [aria-current] { color: var(--paper); }
  .crumbs--inverse li + li::before { color: var(--border-inverse); }
</style>
