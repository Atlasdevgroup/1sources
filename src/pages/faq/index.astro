---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageIntro from '@/components/ui/PageIntro.astro';
import FAQList from '@/components/ui/FAQList.astro';
import CTABand from '@/components/ui/CTABand.astro';
import { slugify } from '@/lib/format';

const groupsOrder = ['Accounts', 'Ordering', 'Shipping', 'Brands & manufacturers', 'About 1Sources'] as const;
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const groups = groupsOrder
  .map((g) => ({ name: g, id: slugify(g), items: faqs.filter((f) => f.data.group === g).map((f) => ({ q: f.data.q, a: f.data.a })) }))
  .filter((g) => g.items.length);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'FAQ', path: '/faq/' }];

// FAQPage markup lives on this one canonical page only (docs/site-strategy.md §5).
const faqNode = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.data.q, acceptedAnswer: { '@type': 'Answer', text: f.data.a } })),
};
---
<Base
  title="Wholesale Account & Ordering FAQ"
  description="Answers about 1Sources wholesale accounts: who can apply, resale certificates, minimums, pricing, payment, shipping, marketplace sellers and brand partnerships."
  path="/faq/"
  breadcrumbs={crumbs}
  schema={[faqNode]}
>
  <PageIntro
    crumbs={crumbs}
    eyebrow="FAQ"
    title="Questions buyers and brands ask us"
    lead="Straight answers about accounts, ordering, shipping and how we work with brands. If your question isn’t here, call or email and a person will answer it."
  >
    <nav class="jump" slot="aside" aria-label="FAQ sections">
      <ol role="list">
        {groups.map((g) => <li><a href={`#${g.id}`}>{g.name}<span class="num">{g.items.length}</span></a></li>)}
      </ol>
    </nav>
  </PageIntro>

  <section class="section section--flush-top">
    <div class="container">
      {groups.map((g) => (
        <section class="grid fgroup" id={g.id} aria-labelledby={`${g.id}-t`}>
          <h2 class="fgroup__t" id={`${g.id}-t`}>{g.name}</h2>
          <div class="fgroup__list"><FAQList items={g.items} /></div>
        </section>
      ))}
    </div>
  </section>

  <CTABand location="faq" title="Still have a question?" body="Call or email the team — or, if you’re ready, apply for an account and ask us as part of your application." />
</Base>

<style>
  .jump ol { border-top: var(--rule-strong); }
  .jump a { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: var(--rule); text-decoration: none; font-weight: 500; font-size: var(--fs-body-sm); }
  .jump a:hover { color: var(--accent); }
  .jump .num { color: var(--text-muted); }
  .fgroup { row-gap: 16px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .fgroup + .fgroup { margin-top: var(--section-tight); }
  .fgroup__t { grid-column: 1 / -1; font-size: var(--fs-h3); }
  .fgroup__list { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .fgroup__t { grid-column: 1 / span 3; padding-top: 18px; }
    .fgroup__list { grid-column: 4 / -1; }
  }
</style>
