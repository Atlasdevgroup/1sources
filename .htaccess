RewriteEngine On
RewriteRule ^distribution-services$ /services/distribution-services/ [R=301,L]
RewriteRule ^product-sourcing$ /services/product-sourcing/ [R=301,L]
RewriteRule ^brand-finder$ /services/brand-finder/ [R=301,L]
RewriteRule ^inventory-management$ /services/inventory-management/ [R=301,L]
RewriteRule ^home$ / [R=301,L]
RewriteRule ^about$ /about-us/ [R=301,L]
RewriteRule ^contact$ /contact-us/ [R=301,L]
RewriteRule ^category/uncategorized$ /blog/ [R=301,L]
RewriteRule ^terms$ /terms-conditions/ [R=301,L]

# Cache immutable assets
<FilesMatch "\.(css|js|webp|jpg|png|svg|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|xml|txt)$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"

ErrorDocument 404 /404.html
